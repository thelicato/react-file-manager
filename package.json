{
  "name": "@thelicato/react-file-manager",
  "description": "A simple React component to build a Web File Manager",
  "version": "1.1.8",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:css",
    "build:lib": "tsup lib/index.ts --dts",
    "build:css": "tailwindcss -i lib/tailwind.css -o dist/style.css",
    "test": "vitest run --environment jsdom",
    "lint": "eslint .",
    "format": "prettier --write .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.16.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-draggable": "^4.4.6",
    "react-dropzone": "^14.2.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^3.2.8",
    "@storybook/addon-essentials": "^8.6.19",
    "@storybook/addon-interactions": "^8.6.19",
    "@storybook/addon-links": "^8.6.19",
    "@storybook/addon-onboarding": "^8.6.19",
    "@storybook/blocks": "^8.6.19",
    "@storybook/react": "^8.6.19",
    "@storybook/react-vite": "^8.6.19",
    "@storybook/test": "^8.6.19",
    "@testing-library/react": "^15.0.2",
    "@types/inquirer": "^9.0.3",
    "@types/react": "^18.0.26",
    "@types/react-dom": "^18.0.9",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-react": "^4.7.0",
    "chalk": "^5.2.0",
    "esbuild-css-modules-plugin": "^2.7.1",
    "eslint": "^10.13.0",
    "eslint-plugin-storybook": "^10.6.4",
    "fetch-lite": "^1.1.0",
    "inquirer": "^9.1.4",
    "kolorist": "^1.6.0",
    "lightningcss": "^1.24.1",
    "postcss": "^8.4.38",
    "prettier": "^2.8.4",
    "prop-types": "^15.8.1",
    "storybook": "^8.6.19",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.1",
    "tsup": "^9.0.0",
    "type-fest": "^3.5.4",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vite-plugin-css-injected-by-js": "^2.4.0",
    "vitest": "^5.0.5",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint-plugin-mocha-no-only": "^1.1.1",
    "jsdom": "^30.1.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thelicato/react-file-manager"
  },
  "bugs": {
    "url": "https://github.com/thelicato/react-file-manager/issues"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "minimatch": "^11.0.4",
    "glob": "^14.0.3"
  }
}
